# ── ideata-app config. Copy to .env: cp .env.example .env ─────────────────────

# Database (inside the compose network — no need to change)
DATABASE_URL=postgresql://ideata:ideata@db:5432/ideata

# Redis (compose overrides this to redis://redis:6379)
REDIS_URL=redis://redis:6379

# Environment / sessions
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_DOMAIN=

# ── LLM providers: you need AT LEAST ONE, otherwise tracker runs won't work ───
#
# The engines are split across TWO providers. Set both keys if you want all of
# them; with only one key the engines served by the other simply return nothing.
#
# OpenRouter — chatgpt / deepseek / grok / perplexity:
OPENROUTER_API_KEY=
#
# kie.ai — claude / gemini. NOTE: these two do NOT fall back to OpenRouter when
# this key is missing — they are skipped silently, so a run just comes back
# without Claude and Gemini rows. https://kie.ai
KIE_API_KEY=
#
# Yandex (Alice / Neuro) and GigaChat are regional engines with their own keys —
# see the "Integrations" notes below and Settings -> Engines in the app.

# ── SEO data for competitors and keyword suggestions (optional) ───────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
KEYSSO_API_KEY=

# ── Weekly report emails (optional) ───────────────────────────────────────────
RESEND_API_KEY=
SMTP_FROM=noreply@example.com

# ── "Integrations" tab (all optional) ─────────────────────────────────────────
# IMPORTANT: the redirect URIs below must match what you set in each OAuth app,
# and point to YOUR address (replace http://localhost:8080 with your domain).
#
# Yandex Metrica — visits from AI assistants + web analytics.
#   1) create an OAuth app: https://oauth.yandex.ru/client/new
#   2) grant "Yandex Metrica" (read statistics);
#   3) Redirect URI: http://localhost:8080/metrika/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080/metrika/callback
#
# Google Search Console — clicks/impressions/positions (including AI Overviews).
#   1) Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web):
#      https://console.cloud.google.com/apis/credentials
#   2) enable "Google Search Console API";
#   3) Authorized redirect URI: http://localhost:8080/gsc/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8080/gsc/callback
#
# Cloudflare — AI crawler hits on your site (GPTBot, ClaudeBot…). No server keys
# needed: on the "Integrations" tab click "Connect" and paste a Cloudflare API
# token (create one at https://dash.cloudflare.com/profile/api-tokens with
# read access to the zone analytics).

# ── Blog Writer cross-posting (all optional) ──────────────────────────────────
# Only needed if you want the Blog Writer to publish to social platforms. Each
# is a developer OAuth app YOU create; the redirect URI must match exactly and
# point to YOUR address (replace http://localhost:8080 with your domain).
#
# X / Twitter — create an app at https://developer.x.com/en/portal/dashboard
#   (OAuth 2.0, scopes: tweet.read tweet.write users.read offline.access):
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/x/callback
#
# LinkedIn — https://www.linkedin.com/developers/apps (product "Share on LinkedIn"):
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/linkedin/callback
#
# Threads / Meta — https://developers.facebook.com/apps (Threads API use case):
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8080/threads/callback
#
# Telegram, Mastodon, Ghost, Bluesky — NO server keys here: connect each
# per-brand right in the Blog Writer → cross-posting screen (Telegram: a bot
# token from @BotFather added to your channel; Mastodon: instance URL + token).
#
# The three OAuth apps above (X / LinkedIn / Threads) can also be pasted straight
# into the dashboard: Settings → Providers (owner only) — no restart needed.

# OSS: no billing/plans — all features unlocked (1). Set to 0 to restore the
# tariff logic (paywall/limits).
OSS_UNLOCKED=1

# ── Feature flags (keep off for the first launch) ─────────────────────────────
# Daily run scheduler (turn on after you've configured your keys):
AEO_SCHEDULER=off
# Weekly report emails:
REPORTS_ENABLED=0
# AI site analyst (heavy external calls):
SITE_ANALYTIC_ENABLED=false
